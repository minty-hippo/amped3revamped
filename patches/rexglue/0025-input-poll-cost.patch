   // XInput vibration holds until the guest changes it, but SDL rumble expires,
   // and a zero duration expires on the next SDL_UpdateJoysticks. Arm it for
   // SDL's maximum instead; each call cancels the previous effect anyway.
-  return SDL_RumbleGamepad(controller->sdl, vibration->left_motor_speed,
-                           vibration->right_motor_speed, kRumbleDurationMs)
-             ? X_ERROR_SUCCESS
-             : X_ERROR_FUNCTION_FAILED;
+  // amped3 patch 0025: unchanged values are sent again only before the armed
+  // rumble would run out (a call can mean a write to the device: on handhelds
+  // through hidapi, which made Amped 3's video playback stutter).
+  const uint16_t left = vibration->left_motor_speed;
+  const uint16_t right = vibration->right_motor_speed;
+  const uint64_t ticks = SDL_GetTicks();
+  if (controller->rumble_known && controller->rumble_left == left &&
+      controller->rumble_right == right && ticks - controller->rumble_ticks < kRumbleDurationMs / 2) {
+    return X_ERROR_SUCCESS;
+  }
+  if (!SDL_RumbleGamepad(controller->sdl, left, right, kRumbleDurationMs)) {
+    controller->rumble_known = false;
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  controller->rumble_known = true;
+  controller->rumble_left = left;
+  controller->rumble_right = right;
+  controller->rumble_ticks = ticks;
+  return X_ERROR_SUCCESS;
 }
 
