 void InputSystem::RefreshDevices() {
+  // amped3 patch 0025: enumerating every driver's devices builds strings and
+  // vectors per device; a few times a second is enough to notice a pad being
+  // plugged in or out.
+  const auto now = std::chrono::steady_clock::now();
+  if (refreshed_once_ && now - last_refresh_ < std::chrono::milliseconds(250)) {
+    return;
+  }
+  refreshed_once_ = true;
+  last_refresh_ = now;
   std::vector<DeviceInfo> seen;
   std::vector<InputDriver*> owners;
   std::vector<DeviceInfo> enumerated;
