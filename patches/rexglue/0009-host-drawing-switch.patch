diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -122,6 +122,19 @@
 
   void ExecutePacket(uint32_t ptr, uint32_t count);
 
+  // Amped 3 (patch 0009): host drawing off. While off, the command processor
+  // still runs every packet (registers, fences, interrupts, waits, shader
+  // loads), but draws, resolves and swaps do no host GPU work, and occlusion
+  // queries report the fake sample count. For an application that draws the
+  // frames itself. Callable from any thread; the change takes effect at the
+  // next swap packet, so a frame is never half drawn.
+  void SetHostDrawingEnabled(bool enabled) {
+    host_drawing_requested_.store(enabled, std::memory_order_release);
+  }
+  bool IsHostDrawingEnabled() const {
+    return host_drawing_enabled_.load(std::memory_order_acquire);
+  }
+
   bool is_paused() const { return paused_; }
   void Pause();
   void Resume();
@@ -244,6 +257,9 @@
   std::vector<uint32_t> me_bin_;
 
   uint32_t counter_ = 0;
+  // Patch 0009: see SetHostDrawingEnabled.
+  std::atomic<bool> host_drawing_requested_{true};
+  std::atomic<bool> host_drawing_enabled_{true};
 
   uint32_t primary_buffer_ptr_ = 0;
   uint32_t primary_buffer_size_ = 0;
