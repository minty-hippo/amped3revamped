+// amped3 patch 0026: the settings overlay sized from the display's height
+// (720p units), its font drawn at that size and its spacing scaled with it.
+REXCVAR_DEFINE_DOUBLE(settings_overlay_scale, 1.0, "UI",
+                      "Size of the settings overlay (F4): 1 fills about the same share of the "
+                      "screen at any resolution");
+
 namespace rex::ui {
 
+namespace {
+// The scale for one draw of the overlay (restored when it goes).
+struct OverlayScale {
+  ImGuiStyle saved;
+  explicit OverlayScale(float unit) : saved(ImGui::GetStyle()) {
+    ImGui::GetStyle().ScaleAllSizes(unit);
+    ImGui::PushFont(nullptr, 15.0f * unit);
+  }
+  ~OverlayScale() {
+    ImGui::PopFont();
+    ImGui::GetStyle() = saved;
+  }
+};
+}  // namespace
