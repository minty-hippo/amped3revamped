+void CommandProcessor::LoadDeferredShaders() {
+  for (uint32_t i = 0; i < 2; ++i) {
+    DeferredShaderLoad& load = deferred_shader_loads_[i];
+    if (!load.pending) continue;
+    load.pending = false;
+    const auto type = static_cast<xenos::ShaderType>(i);
+    Shader* shader = nullptr;
+    if (load.address) {
+      shader = LoadShader(type, load.address,
+                          memory_->TranslatePhysical<uint32_t*>(load.address), load.dword_count);
+    }
+    // An immediate load can't be repeated: no shader until the next load.
+    (i == 0 ? active_vertex_shader_ : active_pixel_shader_) = shader;
+  }
+}
