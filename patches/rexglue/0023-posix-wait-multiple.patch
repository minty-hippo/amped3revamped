+// amped3 patch 0023: WaitMultiple used to poll every handle with sleeps of up
+// to 1 ms, which became a busy loop when less than a millisecond was left
+// (the sleep rounded down to zero) - an alertable wait, which waits in 1 ms
+// slices, spun all the time (the audio worker kept a whole core busy). Now
+// every signal also bumps one process-wide generation counter, and
+// WaitMultiple sleeps on its condition variable until something is signaled
+// or its time is up.
+struct MultiWaitNotifier {
+  std::mutex mutex;
+  std::condition_variable cv;
+  std::atomic<uint64_t> generation{0};
+  std::atomic<int> waiters{0};
+};
+
+inline MultiWaitNotifier& GetMultiWaitNotifier() {
+  static MultiWaitNotifier* notifier = new MultiWaitNotifier();  // never destroyed
+  return *notifier;
+}
+
+// After a handle became signaled (its state already written).
+inline void NotifyMultiWaiters() {
+  auto& n = GetMultiWaitNotifier();
+  if (n.waiters.load(std::memory_order_seq_cst) == 0) return;
+  {
+    std::lock_guard<std::mutex> lock(n.mutex);
+    n.generation.fetch_add(1, std::memory_order_relaxed);
+  }
+  n.cv.notify_all();
+}
+
