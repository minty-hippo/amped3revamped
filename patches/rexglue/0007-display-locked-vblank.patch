diff --git a/src/graphics/display_vblank.h b/src/graphics/display_vblank.h
new file mode 100644
index 0000000..c1fd85e
--- /dev/null
+++ b/src/graphics/display_vblank.h
@@ -0,0 +1,40 @@
+/**
+ * @file        display_vblank.h
+ * @brief       Waits for the real vertical blank of the monitor showing the game
+ *              (amped3 patch 0007). Windows only; elsewhere Init() fails and the
+ *              guest vblank stays on the timer.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <memory>
+
+namespace rex::graphics {
+
+class DisplayVblank {
+ public:
+  DisplayVblank();
+  ~DisplayVblank();
+  DisplayVblank(const DisplayVblank&) = delete;
+  DisplayVblank& operator=(const DisplayVblank&) = delete;
+
+  // Picks the monitor the game window is on and measures its refresh rate.
+  // Fails if there is no window yet, no DXGI output, or waiting fails.
+  bool Init();
+  // Blocks until the next vertical blank of that monitor.
+  bool Wait();
+  // Refresh rate in Hz: measured by Init(), then tracked by Wait().
+  double refresh_hz() const { return refresh_hz_; }
+  // Whether Init() found the game window (it may not exist yet at start-up).
+  bool window_found() const;
+  // True when the game window has moved to another monitor since Init().
+  bool MonitorChanged() const;
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+  double refresh_hz_ = 0.0;
+};
+
+}  // namespace rex::graphics
diff --git a/src/graphics/display_vblank_win.cpp b/src/graphics/display_vblank_win.cpp
new file mode 100644
index 0000000..677143f
--- /dev/null
+++ b/src/graphics/display_vblank_win.cpp
@@ -0,0 +1,170 @@
+/**
+ * @file        display_vblank_win.cpp
+ * @brief       DXGI-based wait for the game monitor's vertical blank
+ *              (amped3 patch 0007).
+ */
+
+#include "display_vblank.h"
+
+#include <rex/logging.h>
+
+#if defined(_WIN32)
+
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <dxgi.h>
+
+#include <algorithm>
+#include <chrono>
+#include <vector>
+
+#pragma comment(lib, "dxgi.lib")
+
+namespace rex::graphics {
+
+namespace {
+
+struct FindWindowData {
+  DWORD pid;
+  HWND best;
+  LONG best_area;
+};
+
+BOOL CALLBACK FindProcessWindow(HWND hwnd, LPARAM lparam) {
+  auto* data = reinterpret_cast<FindWindowData*>(lparam);
+  DWORD pid = 0;
+  GetWindowThreadProcessId(hwnd, &pid);
+  if (pid != data->pid || !IsWindowVisible(hwnd) || GetWindow(hwnd, GW_OWNER)) {
+    return TRUE;
+  }
+  RECT rect;
+  if (!GetWindowRect(hwnd, &rect)) return TRUE;
+  LONG area = (rect.right - rect.left) * (rect.bottom - rect.top);
+  if (area > data->best_area) {
+    data->best = hwnd;
+    data->best_area = area;
+  }
+  return TRUE;
+}
+
+HWND FindGameWindow() {
+  FindWindowData data{GetCurrentProcessId(), nullptr, 0};
+  EnumWindows(FindProcessWindow, reinterpret_cast<LPARAM>(&data));
+  return data.best;
+}
+
+}  // namespace
+
+struct DisplayVblank::Impl {
+  IDXGIOutput* output = nullptr;
+  HMONITOR monitor = nullptr;
+  HWND window = nullptr;
+  double period_s = 0.0;
+  std::chrono::steady_clock::time_point last{};
+  ~Impl() {
+    if (output) output->Release();
+  }
+};
+
+DisplayVblank::DisplayVblank() = default;
+DisplayVblank::~DisplayVblank() = default;
+
+bool DisplayVblank::Init() {
+  impl_ = std::make_unique<Impl>();
+  impl_->window = FindGameWindow();
+  if (!impl_->window) return false;
+  impl_->monitor = MonitorFromWindow(impl_->window, MONITOR_DEFAULTTOPRIMARY);
+
+  IDXGIFactory1* factory = nullptr;
+  if (FAILED(CreateDXGIFactory1(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&factory)))) {
+    return false;
+  }
+  IDXGIAdapter1* adapter = nullptr;
+  for (UINT a = 0; !impl_->output && factory->EnumAdapters1(a, &adapter) != DXGI_ERROR_NOT_FOUND;
+       ++a) {
+    IDXGIOutput* output = nullptr;
+    for (UINT o = 0; adapter->EnumOutputs(o, &output) != DXGI_ERROR_NOT_FOUND; ++o) {
+      DXGI_OUTPUT_DESC desc;
+      if (SUCCEEDED(output->GetDesc(&desc)) && desc.Monitor == impl_->monitor) {
+        impl_->output = output;
+        break;
+      }
+      output->Release();
+    }
+    adapter->Release();
+  }
+  factory->Release();
+  if (!impl_->output) return false;
+
+  // Measure the real refresh rate. WaitForVBlank sometimes returns early
+  // (seen with a Direct3D 12 device active), so use the median interval of
+  // many waits instead of the average.
+  if (FAILED(impl_->output->WaitForVBlank())) return false;
+  constexpr int kSamples = 41;
+  std::vector<double> intervals;
+  intervals.reserve(kSamples);
+  auto previous = std::chrono::steady_clock::now();
+  for (int i = 0; i < kSamples; ++i) {
+    if (FAILED(impl_->output->WaitForVBlank())) return false;
+    const auto now = std::chrono::steady_clock::now();
+    intervals.push_back(std::chrono::duration<double>(now - previous).count());
+    previous = now;
+  }
+  std::nth_element(intervals.begin(), intervals.begin() + kSamples / 2, intervals.end());
+  const double median = intervals[kSamples / 2];
+  if (median <= 0.0) return false;
+  impl_->period_s = median;
+  impl_->last = previous;
+  refresh_hz_ = 1.0 / median;
+  return true;
+}
+
+bool DisplayVblank::Wait() {
+  if (!impl_ || !impl_->output) return false;
+  // Ignore early returns (less than half a refresh since the last vblank) so a
+  // spurious wake-up never produces an extra guest vblank.
+  for (int attempt = 0; attempt < 4; ++attempt) {
+    if (FAILED(impl_->output->WaitForVBlank())) return false;
+    const auto now = std::chrono::steady_clock::now();
+    const double since = std::chrono::duration<double>(now - impl_->last).count();
+    if (since >= 0.35 * impl_->period_s || attempt == 3) {
+      impl_->last = now;
+      // Track the refresh rate as it runs: laptop panels with Windows'
+      // dynamic refresh rate switch between 60 and 120 Hz on the fly.
+      if (since < 3.0 * impl_->period_s) {
+        impl_->period_s = 0.9 * impl_->period_s + 0.1 * since;
+        refresh_hz_ = 1.0 / impl_->period_s;
+      }
+      return true;
+    }
+  }
+  return true;
+}
+
+bool DisplayVblank::window_found() const { return impl_ && impl_->window; }
+
+bool DisplayVblank::MonitorChanged() const {
+  if (!impl_ || !impl_->window || !IsWindow(impl_->window)) return true;
+  return MonitorFromWindow(impl_->window, MONITOR_DEFAULTTOPRIMARY) != impl_->monitor;
+}
+
+}  // namespace rex::graphics
+
+#else  // !_WIN32
+
+namespace rex::graphics {
+struct DisplayVblank::Impl {};
+DisplayVblank::DisplayVblank() = default;
+DisplayVblank::~DisplayVblank() = default;
+bool DisplayVblank::Init() { return false; }
+bool DisplayVblank::Wait() { return false; }
+bool DisplayVblank::MonitorChanged() const { return false; }
+bool DisplayVblank::window_found() const { return false; }
+}  // namespace rex::graphics
+
+#endif
