--- a/include/rex/system/gpu_plugin.h
+++ b/include/rex/system/gpu_plugin.h
@@ -61,4 +61,12 @@
 void SetDrawResolutionScaleCap(uint32_t cap);
 uint32_t GetDrawResolutionScaleCap();
 
+// Called by the command processor before an EVENT_WRITE_SHD packet stores its
+// value (physical address without the endian bits, value before the swap); it
+// may block, holding the GPU there (amped3 patch 0019: the native renderer
+// holds Direct3D's fences until it has read what the draws before them use).
+using GpuEventWriteHook = void (*)(uint32_t physical_address, uint32_t value);
+void SetGpuEventWriteHook(GpuEventWriteHook hook);
+GpuEventWriteHook GetGpuEventWriteHook();
+
 }  // namespace rex::system
--- a/src/system/gpu_plugin_loader.cpp
+++ b/src/system/gpu_plugin_loader.cpp
@@ -109,6 +109,16 @@
 
 void SetDrawResolutionScaleCap(uint32_t cap) { g_draw_resolution_scale_cap.store(cap); }
 
+namespace {
+std::atomic<GpuEventWriteHook> g_event_write_hook{nullptr};
+}  // namespace
+
+void SetGpuEventWriteHook(GpuEventWriteHook hook) { g_event_write_hook.store(hook); }
+
+GpuEventWriteHook GetGpuEventWriteHook() {
+  return g_event_write_hook.load(std::memory_order_acquire);
+}
+
 uint32_t GetDrawResolutionScaleCap() { return g_draw_resolution_scale_cap.load(); }
 
 }  // namespace rex::system
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -17,6 +17,7 @@
 
 #include <fmt/format.h>
 
+#include <rex/system/gpu_plugin.h>
 #include <rex/cvar.h>
 #include <rex/dbg.h>
 #include <rex/perf/counter.h>
@@ -1232,6 +1233,8 @@
   }
   auto endianness = static_cast<xenos::Endian>(address & 0x3);
   address &= ~0x3;
+  // Patch 0019: the application may hold the GPU here (fences).
+  if (auto hook = rex::system::GetGpuEventWriteHook()) hook(address, data_value);
   data_value = GpuSwap(data_value, endianness);
   memory::store(memory_->TranslatePhysical(address), data_value);
   return true;
