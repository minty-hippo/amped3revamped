   }
 
+  // Integer scaling: the largest whole multiple of the guest output that fits
+  // the surface, centered (falls back to the fit above when even 1x doesn't).
+  if (PresentIntegerScaling() && properties.frontbuffer_width && properties.frontbuffer_height) {
+    const uint32_t scale =
+        std::min(surface_width_in_paint_connection_ / properties.frontbuffer_width,
+                 surface_height_in_paint_connection_ / properties.frontbuffer_height);
+    if (scale >= 1) {
+      output_width = properties.frontbuffer_width * scale;
+      output_height = properties.frontbuffer_height * scale;
+      flow.output_x = (int32_t(surface_width_in_paint_connection_) - int32_t(output_width)) / 2;
+      flow.output_y = (int32_t(surface_height_in_paint_connection_) - int32_t(output_height)) / 2;
+    }
+  }
