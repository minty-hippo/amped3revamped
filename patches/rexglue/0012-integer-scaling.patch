+namespace rex::ui {
+// present_effect = integer: the guest output is shown at the largest whole
+// multiple of its size that fits the window, centered, with nearest-neighbour
+// sampling (the presenters pick the point sampler at initialization).
+bool PresentIntegerScaling() {
+  std::string v = REXCVAR_GET(present_effect);
+  std::transform(v.begin(), v.end(), v.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+  return v == "integer";
+}
