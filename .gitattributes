# Linux scripts must keep LF line endings even when checked out on Windows
# (bash and the container build fail on CRLF).
*.sh text eol=lf
*.py text eol=lf
linux/Containerfile text eol=lf
# Windows scripts stay CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf
# SDK fixes are applied with git apply byte for byte: never convert their
# line endings (Git for Windows' autocrlf would turn them CRLF and they would
# no longer apply).
*.patch -text
